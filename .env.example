# Existing MySQL database. Business schema is reused; Flyway is disabled.
DB_URL=jdbc:mysql://127.0.0.1:3306/housing_rental?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=replace-with-at-least-32-random-bytes

# DeepSeek OpenAI-compatible chat endpoint.
AI_CHAT_MODEL=openai
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
AI_THINKING_MODE=disabled
AI_AGENT_TIMEOUT=30s
AI_AGENT_MAX_TOOL_CALLS=6
AI_STREAM_TIMEOUT=60s
AI_STREAM_MAX_CONCURRENT=50
AI_SIMILARITY_THRESHOLD=0.58

# Hybrid RAG. Run scripts/setup-ai-model.ps1 before the first start.
AI_EMBEDDING_MODEL=transformers
EMBEDDING_MODEL_URI=file:../.runtime/models/bge-small-zh-v1.5/model_quantized.onnx
EMBEDDING_TOKENIZER_URI=file:../.runtime/models/bge-small-zh-v1.5/tokenizer.json
EMBEDDING_CACHE_DIRECTORY=../.runtime/models/cache
AI_VECTOR_STORE=chroma
CHROMA_HOST=http://127.0.0.1
CHROMA_PORT=8000
CHROMA_INITIALIZE_SCHEMA=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Alibaba Cloud OSS
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
# Optional custom domain, e.g. https://img.example.com
OSS_PUBLIC_BASE_URL=
